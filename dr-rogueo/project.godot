;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dr Rogueo"
run/main_scene="uid://b0becqhd40ctb"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Inventory="*res://scripts/items/inventory.gd"
AnimClock="*res://scripts/global/anim_clock.gd"
TraitInventory="*res://scripts/traits/trait_inventory.gd"

[display]

window/size/viewport_width=427
window/size/viewport_height=240
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/copy_all_errors/plugin.cfg", "res://addons/nes_palette_inspector/plugin.cfg")

